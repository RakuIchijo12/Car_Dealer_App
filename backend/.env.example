# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=velora

# Managed Postgres (Neon, Supabase, …) needs TLS:
# PGSSLMODE=require

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:4200

# ── CarImages API (optional) — uniform studio vehicle photography ─────────────
# Both values are required; the key alone will not authenticate.
CARIMAGES_API_KEY=
CARIMAGES_API_SECRET=
CARIMAGES_BASE_URL=https://carimagesapi.com/api/v1
CARIMAGES_ANGLE=front34
