# ── Database ──────────────────────────────────────────────────────────────────
# Either supply a single connection URL — which is what Neon, Supabase and
# Railway hand you — or the discrete fields below. The URL wins when both are
# set, and implies TLS when it carries sslmode=require.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=velora

# Managed Postgres (Neon, Supabase, …) needs TLS:
# PGSSLMODE=require

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
# Comma-separated list of allowed browser origins. Leave empty in production
# when the SPA is served from the same origin as the API — nothing cross-origin
# should be allowed by default.
CORS_ORIGINS=http://localhost:4200

# ── Production / serverless ──────────────────────────────────────────────────
# Set NODE_ENV=production on the host. That switches off TypeORM schema
# auto-sync and caps the connection pool, since each serverless instance opens
# its own and Postgres limits connections per cluster, not per instance.
# NODE_ENV=production
#
# Schema auto-sync is OFF in production by design. Set this to true for the ONE
# deploy that needs to create the tables, then remove it — leaving it on lets
# every cold start ALTER live tables.
# DB_SYNC=true

# ── CarImages API (optional) — uniform studio vehicle photography ─────────────
# Both values are required; the key alone will not authenticate.
CARIMAGES_API_KEY=
CARIMAGES_API_SECRET=
CARIMAGES_BASE_URL=https://carimagesapi.com/api/v1
CARIMAGES_ANGLE=front34
