# See http://help.github.com/ignore-files/ for more about ignoring files.

# ── Dependencies ──────────────────────────────────────────────────────────────
# Unanchored so they match backend/, frontend-app/ and any future workspace.
node_modules/
.pnp
.pnp.js

# ── Build output ──────────────────────────────────────────────────────────────
dist/
tmp/
out-tsc/
bazel-out/
build/
*.tsbuildinfo

# ── Caches ────────────────────────────────────────────────────────────────────
.angular/
.sass-cache/
coverage/
.nyc_output/
.vite/
.eslintcache

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
testem.log
libpeerconnection.log

# ── Environment files — never commit secrets ──────────────────────────────────
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# ── Uploaded vehicle photos (use object storage in production) ────────────────
uploads/
# ...except the seeded vehicle photography, which the CDN serves in production.
# backend/uploads stays ignored: that is the local runtime write target.
!frontend-app/public/uploads/
!frontend-app/public/uploads/**

# ── IDEs and editors ──────────────────────────────────────────────────────────
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.history/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ── System files ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Deploy ────────────────────────────────────────────────────────────────────
.vercel
connect.lock
typings/

# Generated portfolio captures - regenerate rather than version them.
portfolio-shots/
