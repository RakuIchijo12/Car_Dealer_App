# See http://help.github.com/ignore-files/ for more about ignoring files.

# ── Dependencies ──────────────────────────────────────────────────────────────
# Unanchored so they match backend/, frontend-app/ and any future workspace.
node_modules/
.pnp
.pnp.js

# ── Build output ──────────────────────────────────────────────────────────────
dist/
tmp/
out-tsc/
bazel-out/
build/
*.tsbuildinfo

# ── Caches ────────────────────────────────────────────────────────────────────
.angular/
.sass-cache/
coverage/
.nyc_output/
.vite/
.eslintcache

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
testem.log
libpeerconnection.log

# ── Environment files — never commit secrets ──────────────────────────────────
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# ── Uploaded vehicle photos (use object storage in production) ────────────────
uploads/

# ── IDEs and editors ──────────────────────────────────────────────────────────
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.history/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ── System files ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Deploy ────────────────────────────────────────────────────────────────────
.vercel
connect.lock
typings/
