{
  "name": "velora-motors",
  "version": "1.0.0",
  "description": "Velora Motors — pre-owned vehicle storefront and dealership management system",
  "private": true,
  "scripts": {
    "install:all": "npm --prefix backend install && npm --prefix frontend-app install",
    "dev": "concurrently -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --prefix backend run start:dev",
    "dev:web": "npm --prefix frontend-app start",
    "build": "npm run build:api && npm run build:web",
    "build:api": "npm --prefix backend run build",
    "build:web": "npm --prefix frontend-app run build",
    "start": "npm --prefix backend run start:prod",
    "seed": "npm --prefix backend run seed",
    "photos": "npm --prefix backend run photos",
    "lint": "npm --prefix backend run lint",
    "test": "npm --prefix backend test",
    "photos:optimize": "npm --prefix backend run photos:optimize"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
